// Estalvify - Personal Finance App
// Database schema for Prisma + Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL configured in prisma.config.ts (Prisma v7)
}

// ─────────────────────────────────────────────
// AUTH (Auth.js v5 required models)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // User preferences
  timezone String @default("Europe/London")
  currency String @default("EUR")
  // Number format (decimal/thousands separators) used by formatCurrency.
  locale   String @default("es-ES")
  // Language used for date rendering (formatDate) — decoupled from number format.
  language String @default("en-GB")

  // Daily cash-flow alert: warn when a projected account balance dips below
  // this. 0 = "don't go negative"; raise it to keep a cushion.
  lowBalanceThreshold Decimal @default(0) @db.Decimal(15, 2)


  accounts              Account[]
  sessions              Session[]
  bankConnections       BankConnection[]
  bankAccounts          BankAccount[]
  transactions          Transaction[]
  categories            Category[]
  categoryRules         CategoryRule[]
  budgets               Budget[]
  plannedItems          PlannedItem[]
  recurringSeries       RecurringSeries[]
  notifications         Notification[]
  mcpAuthCodes          McpAuthCode[]
  mcpRefreshTokens      McpRefreshToken[]
  dismissedSuggestions  DismissedRecurringSuggestion[]
  ownedHousehold        Household?                     @relation("OwnedHousehold")
  householdMemberships  HouseholdMember[]
  notificationReads     NotificationRead[]
  pushSubscriptions     PushSubscription[]

  // Which alert types may vibrate this member's phone. Personal, like the
  // other per-member prefs: two people in a household can want different
  // things on their lock screen. Empty = the bell only, no push.
  pushTypes NotificationType[] @default([])

  @@map("users")
}

// ─────────────────────────────────────────────
// HOUSEHOLD - Membership + roles over the owner's data scope
// See ai-instructions/context/PLAN_MULTIUSER.md. Domain tables keep hanging
// off the OWNER's userId (the household's data scope); this layer only decides
// which userId a session resolves to and with which role.
// ─────────────────────────────────────────────

model Household {
  id   String @id @default(cuid())
  name String // Display only, e.g. "Casa Alcoba"

  // The User whose `userId` anchors ALL of the household's data. Unique: a
  // user anchors at most one household. Not transferable in v1.
  ownerUserId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("OwnedHousehold", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  invites HouseholdInvite[]

  @@map("households")
}

enum HouseholdRole {
  OWNER // Everything: banks, members, household deletion, Privacy & data
  EDITOR // Domain writes: categorize, rules, plan, recurring, connections
  VIEWER // Read-only
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  // A user can belong to SEVERAL households (phase 6-lite); the active one is
  // a cookie resolved by lib/auth/scope.ts (oldest membership as fallback).
  userId      String
  role        HouseholdRole
  createdAt   DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

// A pending invitation to join a household (phase 2 flow: copyable link).
// The link carries the raw token; only its hash is stored — same pattern as
// McpAuthCode/McpRefreshToken.
model HouseholdInvite {
  id              String        @id @default(cuid())
  householdId     String
  // Compared case-insensitively against the session email, like signIn does.
  email           String
  role            HouseholdRole // Never OWNER
  tokenHash       String        @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invites")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// BANKING - Enable Banking connections
// ─────────────────────────────────────────────

model BankConnection {
  id     String @id @default(cuid())
  userId String

  // Bank identification
  bankId   String // Enable Banking ASPSP ID
  bankName String
  country  String @default("ES")

  // Enable Banking session
  sessionId String @unique // Enable Banking session ID

  // Set only during PENDING_REAUTH when re-authing an existing connection
  reconnectConnectionId String?

  // Available only while status = PENDING_SETUP; cleared when setup completes or is cancelled.
  // Stores minimal account info (uid, name, ibanSuffix, currency, type) — no full IBANs.
  pendingAccounts Json?

  // PSD2 consent validity
  consentExpiresAt DateTime?

  status    BankConnectionStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[]

  // Connections are listed per user; the daily cron scans by status.
  @@index([userId])
  @@index([status])
  @@map("bank_connections")
}

enum BankConnectionStatus {
  ACTIVE
  SYNCING // Sync in progress
  EXPIRED // Token expired, needs re-auth
  PENDING_REAUTH // User must re-authenticate with the bank (OAuth in progress)
  PENDING_SETUP // OAuth done, user is selecting which accounts to import
  REVOKED // User explicitly disconnected
}

model BankAccount {
  id               String @id @default(cuid())
  userId           String
  bankConnectionId String

  // Enable Banking account identifiers. Unique *per user* — a bank uid is only
  // globally unique in practice, and a global constraint let one user's upsert
  // silently retarget another user's account row (see finalizeSetup).
  externalAccountId String  // ID from Enable Banking API
  // Last 4 digits of IBAN only — full IBAN is never stored (privacy)
  iban              String?

  name     String
  // Household holder of this account (free text, e.g. "David"). Purely a
  // reporting dimension: the household view stays the default, and this lets
  // per-holder breakdowns and the income-concentration indicator exist.
  ownerName String?
  type     BankAccountType @default(CHECKING)
  currency String          @default("EUR")
  isActive Boolean         @default(true)

  // Per-account sync tracking (finer-grained than connection-level lastSyncAt)
  lastSyncAt    DateTime? // When this account last synced successfully
  lastSyncError String? // Error from the most recent failed sync (null on success)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnection BankConnection   @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  balances       AccountBalance[]
  transactions   Transaction[]

  // A bank uid is unique within a user, not globally.
  @@unique([userId, externalAccountId])
  @@index([userId])
  @@index([bankConnectionId])
  @@map("bank_accounts")
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT
  INVESTMENT
  OTHER
}

// Daily balance snapshots (fetched by cron job)
model AccountBalance {
  id            String @id @default(cuid())
  bankAccountId String

  date        DateTime @db.Date // Day this balance corresponds to
  balance     Decimal  @db.Decimal(15, 2)
  available   Decimal? @db.Decimal(15, 2) // Available balance (differs from balance for credit)
  currency    String   @default("EUR")
  balanceType String? // e.g. "closingBooked", "expected" (from Enable Banking)

  createdAt DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, date, balanceType])
  @@map("account_balances")
}

// ─────────────────────────────────────────────
// TRANSACTIONS - Immutable, as received from bank
// ─────────────────────────────────────────────

model Transaction {
  id            String @id @default(cuid())
  userId        String
  bankAccountId String

  // Unique bank-side transaction ID (prevents duplicates within an account)
  externalTransactionId String

  // Core financial data
  amount    Decimal              @db.Decimal(15, 2)
  currency  String               @default("EUR")
  direction TransactionDirection // DEBIT or CREDIT

  // Dates
  valueDate DateTime @db.Date // When money actually moved (value date)

  // Descriptors from bank (raw, do not modify)
  description          String?
  // Clean merchant name extracted from the noisy raw descriptor (gateway
  // asterisks, "PAGO CON TARJETA" scaffolding, city/country suffixes, reference
  // numbers) — for display (Detected list) and detection grouping. Matching
  // still runs over description/remittanceInfo via normalizeDescriptor.
  merchant             String?
  // Last 4 digits of counterparty IBANs only — full IBANs are never stored (privacy)
  creditorIban         String?
  debtorIban           String?
  remittanceInfo       String? // Payment reference (SEPA; may contain free text)
  merchantCategoryCode String? // MCC code (card transactions only)

  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  categorization TransactionCategorization?

  @@unique([bankAccountId, externalTransactionId])
  @@index([userId, valueDate])
  @@index([bankAccountId, valueDate])
  @@map("transactions")
}


enum TransactionDirection {
  DEBIT // Money out
  CREDIT // Money in
}

// ─────────────────────────────────────────────
// CATEGORIES - Hierarchical, user-editable
// ─────────────────────────────────────────────

model Category {
  id     String  @id @default(cuid())
  userId String? // null = system default (shared for all users)

  name            String
  description     String?
  color           String  @default("#6366f1") // Hex color for UI
  icon            String? // Icon name (Lucide icon key)
  // What this category means for money totals. Drives every sum in the app:
  // spending counts EXPENSE only, and the income/expense trend ignores TRANSFER
  // so a movement between your own accounts stops inflating both sides.
  kind            CategoryKind @default(EXPENSE)
  isSystem        Boolean @default(false) // Predefined, cannot be deleted
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  // Self-referential for subcategories
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryRules         CategoryRule[]              @relation("TargetCategoryRules")
  sourceCategoryRules   CategoryRule[]              @relation("SourceCategoryRules")
  transactionCategories TransactionCategorization[]
  budgetItems           BudgetItem[]
  plannedItems          PlannedItem[]
  recurringSeries       RecurringSeries[]

  // Almost every page reads the user's categories (OR system defaults).
  @@index([userId])
  @@map("categories")
}

enum CategoryKind {
  EXPENSE // Money genuinely spent
  INCOME // Money genuinely earned
  TRANSFER // Moves between your own accounts — never counted as either
}

// User-defined rules for automatic categorization
model CategoryRule {
  id         String @id @default(cuid())
  userId     String
  categoryId String // Target category for matched transactions

  name String
  // ConditionNode tree: {op: "AND"|"OR", children: [...]} where a leaf is
  // {field, operator, value, negate?}. A bare array is read as an AND group
  // (legacy shape). See lib/rules/rule-dto.ts for fields and operators.
  conditions Json

  // Optional: only match transactions already in this category (re-categorization)
  sourceCategoryId String?

  isActive           Boolean @default(true)
  // Position in the user's rule list, 0-based and renumbered contiguously on
  // reorder: lower = evaluated first, first match wins. The number is storage
  // only — the UI shows the order, never the value.
  priority           Int     @default(0)
  applyRetroactively Boolean @default(false)

  // Audit (PLAN_MULTIUSER.md phase 5): which MEMBER performed the manual
  // mutation. No FK on purpose — historical value; a removed member must not
  // block or cascade. Null = pre-audit rows, system paths (sync, rule runs)
  // and MCP writes.
  actorUserId String?

  // Observability: refreshed on every run so a rule that matches nothing is visible
  matchCount  Int       @default(0) // Matches in the most recent run, not cumulative
  lastRunAt   DateTime?
  lastMatchAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category                    @relation("TargetCategoryRules", fields: [categoryId], references: [id])
  sourceCategory        Category?                   @relation("SourceCategoryRules", fields: [sourceCategoryId], references: [id])
  transactionCategories TransactionCategorization[]
  recurringSeries       RecurringSeries[]

  // Rules are loaded per user, ordered by priority, on every run and list.
  @@index([userId, priority])
  @@map("category_rules")
}

// The categorization of a transaction (one per transaction, approved by user)
model TransactionCategorization {
  id            String @id @default(cuid())
  transactionId String @unique
  categoryId    String

  status CategorizationStatus @default(PENDING)
  source CategorizationSource // How the categorization was suggested

  // Which rule triggered this (if source = RULE)
  categoryRuleId String?

  // Audit (PLAN_MULTIUSER.md phase 5): which MEMBER performed the manual
  // mutation. No FK on purpose — historical value; a removed member must not
  // block or cascade. Null = pre-audit rows, system paths (sync, rule runs)
  // and MCP writes.
  actorUserId String?

  // Undo trail for rule runs: what this row held before a rule overwrote it.
  // previousCategoryId has no FK on purpose — it is a historical value and a
  // deleted category must not block the undo.
  previousCategoryId String?
  previousSource     CategorizationSource?
  categorizedAt      DateTime?

  // User approval
  approvedAt DateTime?
  rejectedAt DateTime?
  note       String? // Optional user note

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction  Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  categoryRule CategoryRule? @relation(fields: [categoryRuleId], references: [id])

  // Hot filters: grouping by category, and looking up / detaching a rule's rows.
  @@index([categoryId])
  @@index([categoryRuleId])
  @@map("transaction_categorizations")
}

enum CategorizationStatus {
  PENDING // Suggested, waiting for user approval
  APPROVED // User confirmed
  REJECTED // User rejected (will be re-queued for manual categorization)
}

enum CategorizationSource {
  RULE // Matched a user-defined rule
  AI // Reserved for AI-assisted categorization (not implemented yet)
  MANUAL // User categorized manually
}

// ─────────────────────────────────────────────
// BUDGETS - Monthly planning by category
// ─────────────────────────────────────────────

model Budget {
  id     String @id @default(cuid())
  userId String

  year  Int
  month Int // 1–12
  name  String? // Optional label (e.g. "December holiday budget")

  // v4: the monthly savings GOAL, as an INPUT. The variable budget is the
  // residue (income − fixed charges − fund quotas − savingsTarget), never the
  // other way around. Stored per month so the progression stays on record and
  // goal-vs-real is comparable over time.
  savingsTarget Decimal @default(0) @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetItems BudgetItem[]

  @@unique([userId, year, month])
  @@map("budgets")
}

model BudgetItem {
  id         String @id @default(cuid())
  budgetId   String
  categoryId String

  // The month's assignment for the category ("assigned" in the model spec).
  plannedAmount Decimal @db.Decimal(15, 2)
  currency      String  @default("EUR")
  notes         String?

  // false = classic budget, resets every month (groceries, restaurants).
  // true  = accumulation fund: the unspent remainder rolls into next month
  //         (IBI, holidays, car, back-to-school). This boolean IS the sinking
  //         fund - no separate table. The rolled balance is derived from the
  //         fund's monthly rows (assigned - spent, summed), never stored.
  rollover Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
  @@map("budget_items")
}

// ─────────────────────────────────────────────
// PLANNED ITEMS - Dated expected charges (the source of truth)
// ─────────────────────────────────────────────

// One expected charge (or income) with a date, in a specific calendar month.
// Recurring series generate these forward; one-offs (this year's IBI) are typed
// by hand. Both live in the same list and the same screen. The monthly budget
// cascade DERIVES from these — they are the single editable source of truth.
model PlannedItem {
  id     String @id @default(cuid())
  userId String

  description String
  direction   TransactionDirection @default(DEBIT)
  categoryId  String?
  amount      Decimal              @db.Decimal(15, 2)
  currency    String               @default("EUR")

  // Target calendar month plus when in it the charge lands: an exact day, a
  // day window (rent wanders between the 1st and the 6th), or the month's last
  // day (the mortgage — a fixed day number would drop or double a payment
  // around short months).
  year           Int
  month          Int // 1–12
  dueDay         Int?
  windowFromDay  Int?
  windowToDay    Int?
  anchorMonthEnd Boolean @default(false)

  // Which account the charge hits (feeds the per-account balance projection).
  bankAccountId String?

  // Set when this instance was generated from a recurring series; null = a
  // hand-typed one-off. One instance per series per month.
  recurringSeriesId String?

  // Audit (PLAN_MULTIUSER.md phase 5): which MEMBER performed the manual
  // mutation. No FK on purpose — historical value; a removed member must not
  // block or cascade. Null = pre-audit rows, system paths (sync, rule runs)
  // and MCP writes.
  actorUserId String?

  status               PlannedStatus @default(PENDING)
  // matchedTransactionIds is THE source of truth for what a matched item
  // absorbed: always 1..n ids, also for single-charge matches. Consumers read
  // one field with one rule. matchedTransactionId is the LEGACY single-value
  // anchor (the earliest transaction) — kept unique so a transaction anchors at
  // most one planned item, but never read alone.
  matchedTransactionId String?       @unique
  matchedTransactionIds String[]     @default([])
  // What actually arrived (SUM across matchedTransactionIds; deviation vs
  // `amount` drives the price-change alert).
  matchedAmount        Decimal?      @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id])
  recurringSeries RecurringSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: Cascade)

  @@unique([recurringSeriesId, year, month])
  @@index([userId, year, month])
  @@map("planned_items")
}

enum PlannedStatus {
  PENDING // Expected, no transaction seen yet
  MATCHED // A transaction arrived inside the window and was linked
  MISSED  // The window closed with no matching transaction
}


// ─────────────────────────────────────────────
// RECURRING SERIES - Hand-maintained standing charges (manual CRUD)
// ─────────────────────────────────────────────

// A standing charge or income the user maintains BY HAND (at n=1, configuring
// fifteen known series is cheaper than inferring them). Each series generates
// dated PlannedItem instances forward; `merchantKey` is the normalized text the
// matching engine looks for in a transaction's descriptors to link the arrival.
model RecurringSeries {
  id     String @id @default(cuid())
  userId String

  // Normalized text matched (accent/case-folded contains) against a
  // transaction's description + remittanceInfo to recognize this series.
  merchantKey String
  displayName String
  direction   TransactionDirection

  categoryId String?

  // Preferred recognition: point at a categorization rule and reuse its
  // condition tree (amount, word boundaries, regex — already tuned and
  // tested). The category then comes from the rule, so plan and reality can
  // never file the same charge under two categories. merchantKey stays as the
  // fallback for series without a rule.
  ruleId String?

  cadence        RecurringCadence
  expectedAmount Decimal          @db.Decimal(15, 2)
  currency       String           @default("EUR")

  // When in the month the charge lands: a day window (rent: 1-6) or the last
  // day of the month (mortgage - a fixed day number would drop or double a
  // payment around short months). Bimonthly/quarterly/yearly series also carry
  // their anchor month via nextExpectedDate.
  windowFromDay  Int?
  windowToDay    Int?
  anchorMonthEnd Boolean @default(false)

  // Some periods carry SEVERAL charges of the same series (school fees split
  // into base + activities + materials; association dues as separate SEPA
  // debits). When true, each planned instance sums every recognized arrival in
  // its window instead of expecting one charge. Default false = single charge.
  aggregate Boolean @default(false)

  // Calendar months (1–12) this series NEVER bills, on top of the cadence — a
  // school that skips August, an association that skips July. No planned item
  // is generated for those months, so they can't ring a phantom MISSED.
  skipMonths Int[] @default([])

  // Which account the charge hits / the income lands in. Configuration, not
  // inference — rent leaves Despeses, Mònica's salary lands in Estalvis.
  bankAccountId String?

  // Audit (PLAN_MULTIUSER.md phase 5): which MEMBER performed the manual
  // mutation. No FK on purpose — historical value; a removed member must not
  // block or cascade. Null = pre-audit rows, system paths (sync, rule runs)
  // and MCP writes.
  actorUserId String?

  active           Boolean   @default(true)
  lastSeenAt       DateTime? @db.Date
  nextExpectedDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  rule         CategoryRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  plannedItems PlannedItem[]

  @@unique([userId, merchantKey])
  @@map("recurring_series")
}

enum RecurringCadence {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  YEARLY
  IRREGULAR
}

// A recurring-series suggestion the user rejected. Detection only proposes —
// this table is what keeps a rejected proposal from resurfacing on every
// visit. Keyed by the suggestion's merchantKey (normalized descriptor).
model DismissedRecurringSuggestion {
  id          String   @id @default(cuid())
  userId      String
  merchantKey String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("dismissed_recurring_suggestions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS - In-app alerts (budget, recurring, …)
// ─────────────────────────────────────────────

// In-app notifications shown in the header bell. Generated idempotently from the
// user's data (budgets, recurring series) — the (userId, dedupeKey) unique index
// means re-running generation never creates duplicates.
model Notification {
  id     String @id @default(cuid())
  userId String

  type     NotificationType
  severity NotificationSeverity @default(INFO)

  title String
  body  String

  // Idempotency key, e.g. "budget-over:2026-8:<categoryId>". Unique per user.
  dedupeKey String
  metadata  Json? // Extra context for future deep-links (categoryId, merchantKey…)

  // AGGREGATE first-read timestamp: set when the FIRST member reads it, and
  // what retention purges on (read > 90 days). The per-member read state the
  // UI shows lives in NotificationRead — never read readAt for display.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads NotificationRead[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Per-member read state for the shared household bell (PLAN_MULTIUSER.md
// phase 5): one row = this member has read this notification. Notifications
// hang off the household's dataUserId, so without this table one member's
// "mark read" blanked the other's bell.
// Web Push endpoints, one row per browser/device a member opted in from.
//
// Delivery target for the same notifications shown in the bell. Attached to the
// MEMBER (actorUserId), not to the household's anchor user: a subscription is a
// property of a device, and every member of a household should be able to get
// the household's alerts on their own phone (see lib/notifications/push.ts).
//
// On iOS these only exist for *installed* PWAs — Safari does not expose
// PushManager in a normal browser tab.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  // Push service URL identifying this device. Unique globally: the browser
  // reissues the same endpoint, so re-subscribing must update, not duplicate.
  endpoint String @unique
  // Keys from the browser's PushSubscription, needed to encrypt payloads.
  p256dh   String
  auth     String

  userAgent String?
  createdAt DateTime @default(now())

  // Why the last send to this device failed, and when. Kept so a rejection
  // (a bad VAPID subject, a rate limit) is visible in Settings instead of
  // dying in a server log nobody can read. Cleared on the next success.
  lastError   String?
  lastErrorAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String // the MEMBER who read it (actorUserId)
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

enum NotificationType {
  BUDGET_OVER
  BUDGET_NEAR
  RECURRING_UPCOMING
  RECURRING_AMOUNT_CHANGE // A recurring charge deviated from its usual amount
  RECURRING_MISSED // An expected recurring charge never arrived
  SAVINGS_NOT_EXECUTED // Savings goal set but no transfer landed this month
  EXTRAORDINARY_INCOME // An income arrived far above its usual amount
  LOW_BALANCE_PROJECTED
  CONSENT_EXPIRING // PSD2 consent about to lapse — warn before syncing stops
  NO_TRANSACTIONS // Nothing new for days; the sync may have died quietly
}

enum NotificationSeverity {
  INFO
  WARNING
  ALERT
}

// ─────────────────────────────────────────────
// SYNC LOG - Track daily cron job runs
// ─────────────────────────────────────────────

model SyncLog {
  id     String  @id @default(cuid())
  userId String?

  syncDate            DateTime   @db.Date // Which day's data was synced
  status              SyncStatus
  transactionsFetched Int        @default(0)
  accountsSynced      Int        @default(0)
  errorMessage        String?
  durationMs          Int?

  createdAt DateTime @default(now())

  @@index([syncDate])
  @@map("sync_logs")
}

enum SyncStatus {
  SUCCESS
  PARTIAL // Some accounts failed
  FAILED
}

// ─────────────────────────────────────────────
// RATE LIMITS - Fixed-window counters (lib/rate-limit.ts)
// ─────────────────────────────────────────────

// One row per (limiter, caller) pair, e.g. "oauth-token:203.0.113.7". Postgres
// is the shared store because serverless invocations share nothing else — an
// in-memory counter would reset on every cold start. Stale rows are purged by
// the daily retention job.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)

  @@index([windowStart])
  @@map("rate_limits")
}

// ─────────────────────────────────────────────
// MCP - OAuth 2.1 Authorization Server (for the MCP API)
// See lib/mcp/oauth.ts for the crypto primitives.
// ─────────────────────────────────────────────

model McpOAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  authCodes     McpAuthCode[]
  refreshTokens McpRefreshToken[]

  @@map("mcp_oauth_clients")
}

model McpAuthCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scope               String?
  // The household ACTIVE at consent time — the tokens bind to it. Null =
  // pre-multi-household grant; the token endpoint falls back to the user's
  // oldest membership. No FK: validated live against household_members.
  householdId         String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("mcp_auth_codes")
}

model McpRefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  clientId    String
  userId      String
  scope       String?
  // Carried forward through rotation from the auth code (see McpAuthCode).
  householdId String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  client McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("mcp_refresh_tokens")
}
