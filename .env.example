# Estalvify environment variables.
# Copy to .env.local and fill in. Placeholders only here — never commit real secrets.

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection used at runtime by the Neon serverless adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used for Prisma migrations. Optional: falls
# back to DATABASE_URL when unset. Only ever set it alongside a DATABASE_URL
# for the SAME Neon branch — Prisma prefers DIRECT_URL, so a mismatched pair
# migrates one database while the app reads another. On Vercel it is set for
# `production`, for `development`, and for the `preview` git branch — each
# against its own Neon branch. Feature-branch previews leave it unset so
# migrations follow the ephemeral branch URL the Neon integration injects.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth (Auth.js v5 / Google OAuth) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: stable proxy URL for OAuth redirects on preview deployments.
AUTH_REDIRECT_PROXY_URL=""

# ── Enable Banking (PSD2 open banking) ────────────────────────────────────
ENABLE_BANKING_APP_ID=""
# Provide the RS256 private key inline OR via a file path (one of the two).
ENABLE_BANKING_PRIVATE_KEY=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Must EXACTLY match a redirect URI registered in the Enable Banking app config.
# Set this on ALL Vercel environments so previews send an allowed value instead
# of their per-deploy origin (otherwise reconnect fails with REDIRECT_URI_NOT_ALLOWED).
ENABLE_BANKING_REDIRECT_URI="https://estalvify.vercel.app/api/banking/callback"

# ── AI insights (provider-agnostic wrapper in lib/ai) ─────────────────────
# Which provider to use. Currently "claude" (default). Swappable without code changes.
AI_PROVIDER="claude"
# Anthropic API key — required for AI insights. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-5).
AI_MODEL="claude-opus-5"

# ── App / cron ────────────────────────────────────────────────────────────
# No canonical-app-URL variable on purpose: nothing needs one. The banking
# callback derives its origin from the request, and the PSD2 redirect URI has to
# be an exact match of a registered value (ENABLE_BANKING_REDIRECT_URI above).
# If you ever do need the production domain, Vercel provides
# VERCEL_PROJECT_PRODUCTION_URL for free — prefer it over VERCEL_URL. Per Vercel's
# system-env-vars docs: VERCEL_PROJECT_PRODUCTION_URL "is always set, even in
# preview deployments" and is "useful to reliably generate links that point to
# production", whereas VERCEL_URL is the generated per-deployment URL and "cannot
# be used in conjunction with Standard Deployment Protection". Neither includes
# the https:// scheme.
# Shared secret protecting the daily cron endpoint (/api/cron/sync).
CRON_SECRET=""

# ── MCP API (OAuth 2.1 Authorization Server) ──────────────────────────────
# Secret used to sign MCP access tokens (JWT HS256). Optional: if unset, the
# MCP server falls back to AUTH_SECRET. Set a dedicated value to rotate MCP
# tokens independently of app sessions.
MCP_JWT_SECRET=""

# ── MCP access control ────────────────────────────────────────────────────
# Who may sign in (app + MCP, which shares the login). Comma-separated,
# case-insensitive. Matching lives in `lib/auth/allowed-emails.ts`. Entries:
#   david@example.com  one exact address
#   example.com        any address at that domain (same as @example.com
#                      and *@example.com — a bare entry is a domain)
#   *.example.com      any SUBdomain of example.com. Does NOT include
#                      example.com itself: list both when you want the apex too.
#   postmaster@*       that mailbox at any domain
#   *                  everyone. The only spelling of it — `*@*` and `@*` are
#                      rejected, so writing those denies sign-in, not opens it.
# Leave empty to allow any Google login — the historical default, kept for
# compatibility. Prefer `*` when you mean it: an allowlist emptied by accident
# and one emptied on purpose otherwise look the same. Malformed entries (`@`,
# `user@`) are dropped rather than read as catch-alls, and a value whose entries
# are ALL malformed denies everyone instead of falling through to open — so a
# typo can lock you out, but never opens sign-in to the world.
ALLOWED_EMAILS=""
# Pre-configured confidential OAuth client for the MCP connector. When
# MCP_OAUTH_CLIENT_ID is set, open Dynamic Client Registration is DISABLED and
# only this client is accepted. If MCP_OAUTH_CLIENT_SECRET is also set, the
# token endpoint requires client authentication (client_secret_post/basic).
MCP_OAUTH_CLIENT_ID=""
MCP_OAUTH_CLIENT_SECRET=""
# Both are set on Vercel for `production` and `preview` (not `development`, so
# local runs keep DCR enabled and need no client config).
# Comma-separated exact redirect URIs for the client. Leave EMPTY for an
# Anthropic-hosted client: with no list, any redirect on claude.ai / claude.com is
# accepted by the static client's host rule, which survives Anthropic changing its
# callback path. Pin it only for a non-Anthropic client. Unset on Vercel.
MCP_OAUTH_REDIRECT_URIS=""
