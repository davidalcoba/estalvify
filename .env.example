# Estalvify environment variables.
# Copy to .env.local and fill in. Placeholders only here — never commit real secrets.

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection used at runtime by the Neon serverless adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth (Auth.js v5 / Google OAuth) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: stable proxy URL for OAuth redirects on preview deployments.
AUTH_REDIRECT_PROXY_URL=""

# ── Enable Banking (PSD2 open banking) ────────────────────────────────────
ENABLE_BANKING_APP_ID=""
# Provide the RS256 private key inline OR via a file path (one of the two).
ENABLE_BANKING_PRIVATE_KEY=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Must EXACTLY match a redirect URI registered in the Enable Banking app config.
# Set this on ALL Vercel environments so previews send an allowed value instead
# of their per-deploy origin (otherwise reconnect fails with REDIRECT_URI_NOT_ALLOWED).
ENABLE_BANKING_REDIRECT_URI="https://estalvify.vercel.app/api/banking/callback"

# ── App / cron ────────────────────────────────────────────────────────────
# Canonical app URL (fallback used when building redirect URLs).
NEXT_PUBLIC_APP_URL="https://estalvify.vercel.app"
# Shared secret protecting the daily cron endpoint (/api/cron/sync).
CRON_SECRET=""
