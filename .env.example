# Estalvify environment variables.
# Copy to .env.local and fill in. Placeholders only here — never commit real secrets.

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Pooled connection used at runtime by the Neon serverless adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used for Prisma migrations. Optional: falls
# back to DATABASE_URL when unset. Only ever set it alongside a DATABASE_URL
# for the SAME Neon branch — Prisma prefers DIRECT_URL, so a mismatched pair
# migrates one database while the app reads another. On Vercel it is set only
# for the `preview` git branch; feature-branch previews leave it unset so
# migrations follow the ephemeral branch URL the Neon integration injects.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth (Auth.js v5 / Google OAuth) ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional: stable proxy URL for OAuth redirects on preview deployments.
AUTH_REDIRECT_PROXY_URL=""

# ── Enable Banking (PSD2 open banking) ────────────────────────────────────
ENABLE_BANKING_APP_ID=""
# Provide the RS256 private key inline OR via a file path (one of the two).
ENABLE_BANKING_PRIVATE_KEY=""
ENABLE_BANKING_PRIVATE_KEY_PATH=""
# Must EXACTLY match a redirect URI registered in the Enable Banking app config.
# Set this on ALL Vercel environments so previews send an allowed value instead
# of their per-deploy origin (otherwise reconnect fails with REDIRECT_URI_NOT_ALLOWED).
ENABLE_BANKING_REDIRECT_URI="https://estalvify.vercel.app/api/banking/callback"

# ── AI insights (provider-agnostic wrapper in lib/ai) ─────────────────────
# Which provider to use. Currently "claude" (default). Swappable without code changes.
AI_PROVIDER="claude"
# Anthropic API key — required for AI insights. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-5).
AI_MODEL="claude-opus-5"

# ── App / cron ────────────────────────────────────────────────────────────
# Canonical app URL (fallback used when building redirect URLs).
NEXT_PUBLIC_APP_URL="https://estalvify.vercel.app"
# Shared secret protecting the daily cron endpoint (/api/cron/sync).
CRON_SECRET=""

# ── MCP API (OAuth 2.1 Authorization Server) ──────────────────────────────
# Secret used to sign MCP access tokens (JWT HS256). Optional: if unset, the
# MCP server falls back to AUTH_SECRET. Set a dedicated value to rotate MCP
# tokens independently of app sessions.
MCP_JWT_SECRET=""

# ── MCP access control ────────────────────────────────────────────────────
# Comma-separated Google emails allowed to sign in. When set, ONLY these
# accounts can authenticate (app + MCP). Leave empty to allow any Google login.
ALLOWED_EMAILS=""
# Pre-configured confidential OAuth client for the MCP connector. When
# MCP_OAUTH_CLIENT_ID is set, open Dynamic Client Registration is DISABLED and
# only this client is accepted. If MCP_OAUTH_CLIENT_SECRET is also set, the
# token endpoint requires client authentication (client_secret_post/basic).
MCP_OAUTH_CLIENT_ID=""
MCP_OAUTH_CLIENT_SECRET=""
# Comma-separated exact redirect URIs for the client. Anthropic hosts
# (claude.ai / claude.com) are also trusted for the static client.
MCP_OAUTH_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback"
